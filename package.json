{
  "name": "@marcfs31/fors-observability-design-system",
  "version": "1.4.1",
  "private": false,
  "description": "Fors Corporation observability design system — brand tokens, React components, and data-visualization + observability primitives.",
  "author": "Fors Corporation <developer@marcfors.com>",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.cts",
        "default": "./dist/tailwind-preset.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme",
    "tailwind-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcfs31/fors-observability-design-system.git"
  },
  "homepage": "https://marcfs31.github.io/fors-observability-design-system/",
  "bugs": {
    "url": "https://github.com/marcfs31/fors-observability-design-system/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles/package.css -o dist/styles.css --minify && node -e \"const fs=require('fs');for(const f of ['fonts.css','tailwind.css'])fs.copyFileSync('src/styles/'+f,'dist/'+f)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "test-storybook --url http://127.0.0.1:6006",
    "test:storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static -p 6006 -a 127.0.0.1 -s\" \"wait-on tcp:127.0.0.1:6006 && npm run test:storybook\"",
    "test:package": "npm run build && publint --strict && attw --pack . --exclude-entrypoints styles.css tailwind.css fonts.css package.json",
    "size": "npm run build && size-limit",
    "smoke": "node scripts/smoke-test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "test:consumer": "npm run build && node scripts/consumer-test.mjs"
  },
  "size-limit": [
    {
      "name": "JS bundle (import * from index.js, incl. Radix + cmdk + react-day-picker deps, brotli). Raised from 85 KB when the data-viz + observability families landed — they add ~3 KB of hand-rolled SVG geometry and no new dependency.",
      "path": "dist/index.js",
      "limit": "92 KB"
    },
    {
      "name": "Compiled CSS (brotli)",
      "path": "dist/styles.css",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.11.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^8.3.5",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@storybook/test": "^8.3.5",
    "@storybook/test-runner": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.0.3",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "publint": "^0.2.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.2.0",
    "storybook": "^8.3.5",
    "tailwindcss": "^3.4.10",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
